# Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# API Configuration
# 127.0.0.1 (not localhost) to force IPv4: the backend binds to IPv4 loopback,
# while `localhost` can resolve to ::1 and hit a different process on port 3001.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api
